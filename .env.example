# Configure SOMENTE no painel privado da Vercel ou em .env.local fora do Git.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SOFIA_EMAIL=
# SOFIA_INITIAL_PASSWORD é usado apenas no preparo local da conta e deve ser removido depois.
SOFIA_INITIAL_PASSWORD=
